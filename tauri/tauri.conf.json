{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作提醒助手",
  "version": "2.0.0",
  "identifier": "cn.gf.workreminder",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "我的提醒",
        "width": 780,
        "height": 560,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
